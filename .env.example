# ==============================================================================
# Office Jukebox - Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Security
# In production, generate a secure random secret key (e.g. `openssl rand -hex 32`)
SECRET_KEY=django-insecure-replace-this-with-a-random-secret-key-for-production

# Set to False in production
DEBUG=True

# Comma-separated allowed hosts (e.g., your-domain.com, office-jukebox.onrender.com, localhost)
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com

# Database Connection (Neon PostgreSQL, Supabase, or SQLite fallback)
# Leave blank to use local SQLite (db.sqlite3) during development.
# Example for Neon PostgreSQL:
# DATABASE_URL=postgresql://neondb_owner:password@ep-cool-pond-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Example for Supabase:
# DATABASE_URL=postgresql://postgres:password@db.xxxxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# YouTube Data API v3 Key
# Obtain free from Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_API_KEY=

# Reverse Proxy Configuration
# Number of reverse proxy hops before reaching Django (1 for Render, Heroku, Cloudflare, AWS ALB)
NUM_PROXIES=1

# CSRF Trusted Origins (comma-separated, include https:// for production domains)
# Example: https://office-jukebox.onrender.com,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Timezone
TIME_ZONE=UTC
